  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mtOrderId])
  @@index([businessTime])
  @@index([status])
  @@map("mt_refund_orders")
}

// ── Phase 4 月结锁账 ────────────────────────────────
// 财务在月末关账后, 此月份所有凭证操作 (新增/反审/作废) 锁定
// 业务自动事件 (招行付款 / 入库) 若落账期间已 CLOSED, 由 voucher service 将日期顺延至下一个 OPEN 期
// 关账同时记录期末结转 carryover (Phase 4 task 3): 主营收入 → 本年利润
model AccountingPeriod {
  id                 String                 @id @default(cuid())
  tenantId           String
  month              String // YYYY-MM 例 "2026-06"
  status             AccountingPeriodStatus @default(OPEN)
  // 关账
  closedAt           DateTime?
  closedById         String?
  closeNote          String?
  // 重新打开 (审计)
  reopenedAt         DateTime?
  reopenedById       String?
  reopenNote         String?
  // 期末结转凭证 (carryover, 主营收入 → 本年利润)
  carryoverVoucherId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, month])
  @@map("accounting_periods")
}

enum AccountingPeriodStatus {
  OPEN // 未锁
  CLOSED // 已锁, 凭证不可改不可加
  REOPENED // 财务长重开 (留痕)
}

model MeituanAuthToken {
  id    String @id @default(cuid())
  orgId Int    @unique

  appAuthToken String    @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime?

  lastRefreshedAt DateTime?
  refreshAttempts Int       @default(0)

  rawPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("meituan_auth_tokens")
}

// ── 备用金 (P1-3) ──────────────────────────────────────
// 真实业务: 店长每月按需申请备用金 (买美菜/快驴等无现场付款的渠道),
//   财务发放, 月底店长报开支明细 + 退回余额, 财务对账归档.
model PettyCash {
  id              String    @id @default(cuid())
  tenantId        String
  storeId         String
  month           String // YYYY-MM, 一个店一个月一笔
  // 申请
  requestedAmount Decimal   @db.Decimal(12, 2)
  requestedById   String
  requestNote     String?
  requestedAt     DateTime  @default(now())
  // 财务批准 + 发放
  approvedById    String?
  approvedAt      DateTime?
  approvedAmount  Decimal?  @db.Decimal(12, 2)
  paidAt          DateTime?
  paidById        String?
  paymentMethod   String? // 现金 / 转账 / 招行
  bankTxNo        String?
  // 月底回收 / 对账
  reconciledAt    DateTime?
  reconciledById  String?
  spentAmount     Decimal?  @db.Decimal(12, 2) // 实际花掉
  returnedAmount  Decimal?  @db.Decimal(12, 2) // 退回的现金
  reconcileNote   String?

  status PettyCashStatus @default(REQUESTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  store    Store              @relation(fields: [storeId], references: [id])
  expenses PettyCashExpense[]

  @@unique([tenantId, storeId, month]) // 一店一月一笔
  @@index([tenantId, status])
  @@map("petty_cash")
}

enum PettyCashStatus {
  REQUESTED // 店长已申请, 待财务批
  APPROVED // 财务已批, 待发放
  PAID // 已发放, 店长使用中
  RECONCILING // 月底已提报开支明细, 待财务对账
  CLOSED // 财务对账完毕 + 退款入账, 归档
  CANCELED // 取消 (申请但没批)
}

model PettyCashExpense {
  id          String   @id @default(cuid())
  pettyCashId String
  date        DateTime @db.Date
  category    String // 美菜 / 快驴 / 散户 / 其他
  amount      Decimal  @db.Decimal(12, 2)
  note        String?
  attachments String[] // OSS URL 数组 (小票/收据照片)
  // 关联 (可选: 报销关联到具体入库单 / 供应商)
  receiptId   String?
  supplierId  String?
  createdById String
  createdAt   DateTime @default(now())

  pettyCash PettyCash @relation(fields: [pettyCashId], references: [id], onDelete: Cascade)

  @@index([pettyCashId])
  @@map("petty_cash_expenses")
}

// ── 工资 (P2-1) ───────────────────────────────────────
// 简化版: 财务上传 Excel 月工资单 → 系统记 batch + 每人明细 → 审批 → 发放 → 自动生成凭证
model Payroll {
  id             String        @id @default(cuid())
  tenantId       String
  storeId        String
  month          String // YYYY-MM
  // 汇总 (从 items 累加, 落库快照)
  totalGross     Decimal?      @db.Decimal(12, 2) // 应发合计
  totalNet       Decimal       @db.Decimal(12, 2) // 实发合计 (主要)
  totalSocialSec Decimal?      @db.Decimal(12, 2) // 社保合计 (扣的)
  totalTax       Decimal?      @db.Decimal(12, 2) // 个税合计
  // 审批
  status         PayrollStatus @default(DRAFT)
  approvedById   String?
  approvedAt     DateTime?
  // 发放
  payDate        DateTime?
  payMethod      String? // 现金 / 招行 / 转账 / 微信
  bankTxNo       String?
  // 自动生成凭证 关联
  voucherId      String? // 凭证 id (生成后回填)
  note           String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  store  Store         @relation(fields: [storeId], references: [id])
  items  PayrollItem[]

  @@unique([tenantId, storeId, month])
  @@index([tenantId, status])
  @@map("payrolls")
}

enum PayrollStatus {
  DRAFT // 上传明细, 财务/老板待批
  APPROVED // 已批待发
  PAID // 已发, 凭证已生成
  VOIDED // 作废
}

model PayrollItem {
  id              String   @id @default(cuid())
  payrollId       String
  employeeName    String
  position        String?
  baseSalary      Decimal? @db.Decimal(10, 2)
  bonus           Decimal? @db.Decimal(10, 2)
  overtime        Decimal? @db.Decimal(10, 2)
  deductSocialSec Decimal? @db.Decimal(10, 2)
  deductTax       Decimal? @db.Decimal(10, 2)
  deductOther     Decimal? @db.Decimal(10, 2)
  netAmount       Decimal  @db.Decimal(10, 2) // 实发
  note            String?

  payroll Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([payrollId])
  @@map("payroll_items")
}
