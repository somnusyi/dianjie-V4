{
  "name": "@dianjie/api",
  "version": "1.0.0",
  "scripts": {
    "prisma:generate": "pnpm --filter @dianjie/db generate",
    "predev": "pnpm run prisma:generate",
    "dev": "tsx watch src/index.ts",
    "prebuild": "pnpm run prisma:generate",
    "build": "tsc",
    "prestart": "pnpm run prisma:generate",
    "start": "node dist/index.js",
    "pretest": "pnpm run prisma:generate",
    "test": "vitest run --reporter=verbose",
    "pretest:integration": "pnpm run prisma:generate && node scripts/prepare-integration-db.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter=verbose",
    "pretest:watch": "pnpm run prisma:generate",
    "test:watch": "vitest --reporter=verbose",
    "pretest:coverage": "pnpm run prisma:generate",
    "test:coverage": "vitest run --coverage",
    "pretest:remote": "pnpm run prisma:generate",
    "test:remote": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "7z-wasm": "1.2.0",
    "@dianjie/db": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@paralleldrive/cuid2": "^2.3.1",
    "@prisma/client": "5.22.0",
    "@sentry/node": "^10.48.0",
    "ali-oss": "^6.23.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.1.6",
    "dayjs": "^1.11.10",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "fastify": "^4.26.1",
    "ioredis": "^5.3.2",
    "pino-pretty": "^13.1.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.5",
    "@vitest/coverage-v8": "^1.6.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
