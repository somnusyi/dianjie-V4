  correlationId String
  apiPath       String
  apiTitle      String
  mode          String @db.VarChar(8)

  requestPublic Json
  requestBiz    Json
  signature     String?

  httpStatus     Int?
  httpDurationMs Int?
  responseRaw    String? @db.Text
  responseCode   String?
  responseMsg    String?
  responseData   Json?
  traceId        String?

  errorSeverity String? @db.VarChar(4)
  errorMessage  String? @db.Text
