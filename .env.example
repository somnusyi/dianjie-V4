# ══════════════════════════════════════
# 滇界云管 · 环境变量模板
# 复制为 .env 后填入实际值
# ══════════════════════════════════════

# 数据库（本地开发用 localhost，生产用阿里云 RDS）
DATABASE_URL="postgresql://dianjie:your_password@localhost:5432/dianjie?connection_limit=10&pool_timeout=20"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# 服务端口
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development

# 前端 API 地址
NEXT_PUBLIC_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# 企业微信 Webhook（可选，填入后启用推送）
WECHAT_WEBHOOK_URL=

# Sentry 监控（可选，填入 DSN 后启用）
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# 阿里云 OSS（文件上传）
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ══════════════════════════════════════
# 招商银行新直联（免前置） · 国密微服务（dianjie-v4-cmb）
# 文档: docs/cmb/2026-05-13-招行BB1PAY-报文规范.md
#
# ⚠ 密钥管理 SOP:
#   - 本地/测试: 复制本文件为 .env, 填入测试值 (test 环境 key 在 ~/Desktop/免前置Demo/云洱密钥.txt)
#   - 生产 ECS: /etc/dianjie/secrets.env (chmod 600, owner=root), pm2 用 --env-file 指向该文件
#               源码内严禁硬编码任何 CMB_PRIVATE_KEY / CMB_SYM_KEY default
#   - 缺任意必填项 (UID/ACCOUNT/PRIVATE_KEY/PUBLIC_KEY/SYM_KEY) → apps/cmb/app.py 启动即 raise
# ══════════════════════════════════════
CMB_USE_PROD=false                                # true=生产 https://cdc.cmbchina.com / false=测试
CMB_URL=                                          # 留空走默认（测试 cdctest.cmburl.cn / 生产 cdc.cmbchina.com）
CMB_UID=                                          # 测试值 U005182425;生产由银行下发 (USE_PROD=true 时禁止用测试 UID)
CMB_ACCOUNT=                                      # 测试值 655905978110000
CMB_PRIVATE_KEY=                                  # SM2 私钥【必填, 生产必须重新生成, 严禁入 git】
CMB_PUBLIC_KEY=                                   # SM2 公钥 (与私钥配对)
CMB_BANK_PUBLIC_KEY=                              # 银行 SM2 公钥 (测试/生产不同;留空走代码内 default)
CMB_SYM_KEY=                                      # SM4 对称密钥 16 字节【必填】
CMB_BUSMOD=S100B                                  # 支付业务模式（DCLISMOD self-check 后定）
CMB_BUSCOD=N02030                                 # 业务代码
CMB_CCY_NBR=10                                    # 货币码 10=RMB
CMB_SERVICE_PORT=5001                             # Flask 微服务监听端口
CMB_SERVICE_URL=http://localhost:5001             # Node 客户端调用地址

# ──────────────────────────────────────────────────────────────
# 美团智能版 API 集成 (spec: 2026-05-27)
# Doc: docs/superpowers/specs/2026-05-27-美团智能版-订单同步与可视化-设计稿.md
# ──────────────────────────────────────────────────────────────

# 开关 (默认全关 → cron 不会自动跑)
MEITUAN_ENABLED=false                # true 时启用 cron
MEITUAN_MODE=mock                    # mock | real

# 应用凭证 (从美团开发者后台拿, 见工单回复)
MEITUAN_DEVELOPER_ID=                # 长整型, 如 mB|XXXX 后面那串
MEITUAN_APP_SECRET=                  # 签名密钥, 严禁泄漏
MEITUAN_BUSINESS_ID=18               # 智能版固定 18

# 门店组织 (从美团 /rms-base-v1-auth-resources-poi-get 接口查)
MEITUAN_ORG_ID=                      # 数字
MEITUAN_POI_ID=                      # 数字, 仅记录用

# token 引导值 (首次启动种入 DB, 之后由 refresh 机制自动更新)
MEITUAN_BOOTSTRAP_AUTH_TOKEN=        # 形如 V2-xxxxxxxx...
MEITUAN_BOOTSTRAP_REFRESH_TOKEN=     # 如果美团给了

# API 基础 URL (默认即可, 不用改)
MEITUAN_API_BASE=https://api-open-cater.meituan.com
