{
  "name": "dianjie",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "20.x",
    "pnpm": "10.32.1"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm --filter @dianjie/db generate && pnpm -r build",
    "env:check": "node scripts/verify-runtime-contract.mjs",
    "db:push": "pnpm --filter @dianjie/db db:push",
    "db:migrate": "pnpm --filter @dianjie/db db:migrate",
    "db:studio": "pnpm --filter @dianjie/db db:studio",
    "db:seed": "pnpm --filter @dianjie/db db:seed"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ],
    "overrides": {
      "sharp": "^0.33.5"
    }
  }
}
