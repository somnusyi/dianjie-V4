// ── 供应商库存流水（每次入库/出库/盘点都一条审计记录）────
// 设计原则: append-only, 不修改/不删除. balanceAfter 记录变动后余额, 方便审计核对.
model SupplierStockMovement {
  id           String            @id @default(cuid())
  tenantId     String
  supplierId   String // 哪家供应商的库存
  productId    String // 哪个 SKU
  delta        Decimal           @db.Decimal(12, 3) // +入库 / -出库
  balanceAfter Decimal           @db.Decimal(12, 3) // 变动完之后的余额 (审计用)
  type         StockMovementType // 变动类型
  reason       String? // 备注 (盘点理由 / 报损原因等)
  sourceType   String? // 'PurchaseOrder' / 'ProductBatch' / 'Manual'
  sourceId     String? // 关联 ID (PO id 等)

  // 批次/保质期 (入库时填, 出库时为空) — 第一期: 仅记录显示, 不做 FIFO 扣减
  manufactureDate DateTime? @db.Date // 生产日期
  expiryDate      DateTime? @db.Date // 到期日期 (= 生产 + 保质期)

  createdById String // 操作人 userId
  createdAt   DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  supplier  Supplier @relation(fields: [supplierId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([supplierId, productId, createdAt])
  @@index([tenantId, createdAt])
  @@map("supplier_stock_movements")
}

enum StockMovementType {
  INITIAL // SKU 创建时的初始库存
  INBOUND_MANUAL // 单条手动入库
  INBOUND_EXCEL // Excel 批量入库
  OUTBOUND_PO // 接单发货自动出库
  ADJUSTMENT // 盘点调整
  LOSS // 报损
}

// ── 库存消耗记录（总厨每日录入）──────────────────────
model StockConsumption {
  id          String   @id @default(cuid())
  tenantId    String
  storeId     String
  productId   String
  date        DateTime @db.Date
  quantity    Decimal  @db.Decimal(14, 6) // BOM 小包装换算需 6 位精度
  note        String?
  // 来源(用于幂等 + 审计): manual / dish_sale:<saleId> / meituan_ingest:<orderId>
  sourceType  String?  @db.VarChar(20)
  sourceId    String?  @db.VarChar(64)
  createdById String
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  store       Store    @relation(fields: [storeId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@unique([sourceType, sourceId, productId], name: "stock_consumption_source_uk")
  @@index([tenantId, date])
  @@map("stock_consumptions")
}

// ── 门店实物盘点快照 ─────────────────────────────────
// 快照是库存的可信基准。历史销售未产生消耗记录时，不能用“累计入库-消耗”冒充现存库存。
model InventorySnapshot {
  id             String   @id @default(cuid())
  tenantId       String
  storeId        String
  snapshotDate   DateTime @db.Date // 闭店盘点日；次日作为期初库存
  sourceFilename String?
  sourceHash     String?  @db.VarChar(64)
  totalValue     Decimal  @db.Decimal(14, 3)
  itemCount      Int
  nonzeroCount   Int
  zeroCount      Int
  matchedCount   Int      @default(0) // 已唯一匹配到采购 SKU 的品项
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant                  @relation(fields: [tenantId], references: [id])
  store  Store                   @relation(fields: [storeId], references: [id])
  items  InventorySnapshotItem[]

  @@unique([storeId, snapshotDate])
  @@index([tenantId, snapshotDate])
  @@map("inventory_snapshots")
}

model InventorySnapshotItem {
  id                  String   @id @default(cuid())
  snapshotId          String
  productId           String?
  section             String?
  rawName             String
  rawSpec             String?
  unit                String
  quantity            Decimal  @db.Decimal(14, 4)
  unitPrice           Decimal  @db.Decimal(14, 4)
  amount              Decimal  @db.Decimal(14, 3)
  // 盘点表保留原单位；以下字段把数量换算到 Product.unit，供盘点后滚动库存使用。
  // 无法可靠换算时保持 null，预计库存必须跳过，不能把“袋/斤”直接当“箱/件”。
  normalizedQuantity  Decimal? @db.Decimal(14, 6)
  normalizedUnit      String?
  normalizationFactor Decimal? @db.Decimal(18, 8)
  normalizationStatus String?  @db.VarChar(20) // EXACT / CONVERTED / PENDING
  normalizationNote   String?
  sortOrder           Int
  createdAt           DateTime @default(now())

  snapshot InventorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  product  Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([snapshotId, sortOrder])
  @@index([productId])
  @@map("inventory_snapshot_items")
}

// ── 门店费用录入（利润表用）────────────────────────
model StoreExpense {
  id        String   @id @default(cuid())
  tenantId  String
  storeId   String
  month     String // 格式 YYYY-MM
  category  String // LABOR / SALES / MGMT / FINANCE
  item      String // 具体项目名，如：门店租金、工资成本
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  store     Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, month, item])
  @@map("store_expenses")
}

// ── 资金台账 ──────────────────────────────────────────
model CashAccount {
  id             String          @id @default(cuid())
  tenantId       String
  name           String // "工商银行对公账户"
  type           CashAccountType @default(BANK)
  bankName       String? // "工商银行昆明分行"
  accountNo      String? // 账号（展示时只显示后4位）
  balance        Decimal         @default(0) @db.Decimal(14, 2)
  note           String?
  // 招行实时账户绑定: 非空 → 走 cmb 微服务按此账号拉实时余额, 覆盖手工 balance
  //                  空   → 普通手工录入账户 (balance 字段单一来源)
  // 需要在招行客户经理处先把 UID 绑定到此账号才能拉到余额
  cmbBindAccount String?
  status         String          @default("ACTIVE") // ACTIVE / DISABLED (软删)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  transactions CashTransaction[]
  invoicePayments InvoicePayment[]

  @@index([tenantId])
  @@map("cash_accounts")
}

model CashTransaction {
  id           String   @id @default(cuid())
  tenantId     String
  accountId    String
  direction    Int // +1 收入  -1 支出
  category     String // "供应商付款" / "营业收入" / "人工" / "其他"
  amount       Decimal  @db.Decimal(12, 2) // 恒正数
  balanceAfter Decimal  @db.Decimal(14, 2) // 交易后余额快照
  note         String?
  txDate       DateTime // 实际交易日期（可填历史）
  refType      String? // 可选关联 "Payment" / "StoreExpense" / "RevenueRecord"
  refId        String?
  createdById  String
  createdAt    DateTime @default(now())

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  account   CashAccount @relation(fields: [accountId], references: [id])
  createdBy User        @relation(fields: [createdById], references: [id])

  @@index([tenantId, txDate(sort: Desc)])
  @@index([accountId])
  @@unique([tenantId, accountId, refType, refId])
  @@map("cash_transactions")
}

enum CashAccountType {
  BANK // 银行账户
  ALIPAY // 支付宝
  WECHAT // 微信支付
  CASH // 现金/备用金
}

// ── 系统通知 ──────────────────────────────────────────
model Notification {
  id            String   @id @default(cuid())
  tenantId      String
  recipientRole String // 目标角色: MANAGER / SUPPLIER_STAFF / ADMIN / FINANCE
  recipientId   String? // 指定用户（空=按角色广播）
  type          String // ORDER_SUBMITTED / SHIPPED / RECEIPT_CONFIRMED / LOSS_CLAIM_RESULT / APPROVAL_PENDING / APPROVAL_DONE
  title         String
  body          String
  refType       String? // PurchaseOrder / LossClaim / PaymentSchedule
  refId         String?
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  recipient User?  @relation(fields: [recipientId], references: [id])

  @@index([tenantId, recipientRole, read])
  @@index([recipientId, read])
  @@map("notifications")
}

// ══════════════════════════════════════════════════════
// 通用审批文档 (v2 documents 模块)
// 用一套表替代各种独立审批：备用金/报销/采购/调价/新供应商/新菜品/合同/调拨/营销预算/调薪
// 阈值 + 角色路由由 services/documentRouting.ts 决定
// ══════════════════════════════════════════════════════
model Document {
  id              String         @id @default(cuid())
  tenantId        String
  no              String // DOC202605000001
  type            DocumentType
  title           String // 简述: "5月差旅报销 / 王伟"
  amount          Decimal?       @db.Decimal(12, 2) // 金额（部分类型可空，如新供应商）
  isOverThreshold Boolean        @default(false) // 是否超阈值（决定是否升级到老板）
  thresholdRule   String? // 命中的规则文字描述
  payload         Json? // 业务字段：报销明细 / 调价对比 / 新菜品定价 等
  storeId         String? // 关联门店（部分单据可空，如调价集团级）
  initiatorId     String // 发起人
  status          DocumentStatus @default(PENDING)
  finalizedAt     DateTime? // 终态时间（APPROVED/REJECTED/CANCELED）
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  store     Store?             @relation(fields: [storeId], references: [id])
  initiator User               @relation(fields: [initiatorId], references: [id])
  steps     DocumentStep[]
  decisions DocumentDecision[]

  @@unique([tenantId, no])
  @@index([tenantId, status, type])
  @@map("documents")
}

model DocumentStep {
  id           String     @id @default(cuid())
  documentId   String
  seq          Int // 第几步 (1-based)
  approverRole String // FINANCE / ADMIN / CHEF_DIRECTOR
  approverId   String? // 完成时记录是谁批的
  status       StepStatus @default(PENDING)
  decidedAt    DateTime?
  comment      String?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approver User?    @relation(fields: [approverId], references: [id])

  @@unique([documentId, seq])
  @@index([approverRole, status])
  @@map("document_steps")
}

model DocumentDecision {
  id         String   @id @default(cuid())
  documentId String
  stepId     String?
  userId     String
  decision   String // APPROVE / REJECT / FORWARD
  comment    String?
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@map("document_decisions")
}

enum DocumentType {
  PETTY_CASH // 备用金申请
  REIMBURSEMENT // 报销
  PURCHASE_FOOD_REGULAR // 食材采购（小额免审，留位备用）
  PURCHASE_FOOD_OVER // 食材采购超阈值
  PURCHASE_NON_FOOD // 非食材采购
  CONTRACT // 合同
  PRICE_ADJUSTMENT // 调价
  NEW_SUPPLIER // 新供应商
  NEW_DISH // 新菜品
  STORE_TRANSFER // 调拨
  MARKETING_BUDGET // 营销预算
  PERSONNEL_PAY // 调薪
  PAYMENT_REQUEST // 付款申请 (税费 / 房租 / 维修 / 咨询 等非订单类支出)
}

enum DocumentStatus {
  PENDING // 进行中（在某步等审）
  APPROVED // 全部步骤通过
  AUTO_APPROVED // 命中阈值自动通过（未走完整审批链）
  REJECTED // 任一步驳回
  CANCELED // 发起人撤回
}

enum StepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED // 阈值内自动跳过
}

// ── 撤销的 token (用于 JWT 主动作废: logout / 离职 / 异常登录) ──
// 设计:
//   - access token (2h) 不查此表, 靠 expiry 自然失效, 性能优先
//   - refresh token (30d) 在 /api/auth/refresh 时查此表, 命中拒绝换 access
//   - logout 把 refresh jti 写入此表, 客户端 access 自然过期后无法续期 → 真正"退出"
//   - 定时清理 expiresAt < now 的行 (后续在 scheduler 加 daily cron)
model RevokedToken {
  id        String   @id @default(cuid())
  jti       String   @unique // JWT payload.jti (UUID)
  userId    String // 便于按用户批量撤销 (离职/封号)
  tokenType String // "access" | "refresh"
  expiresAt DateTime // token 自然过期时间, 用于定时清理
  revokedAt DateTime @default(now())
  reason    String? // logout / admin-revoke / suspicious-login

  @@index([userId])
  @@index([expiresAt])
  @@map("revoked_tokens")
}

