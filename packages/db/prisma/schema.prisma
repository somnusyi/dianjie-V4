  payed          Int
  receivable     Int
  amount         Int
  discount       Int  @default(0)
  income         Int
  serviceFee     Int  @default(0)
  taxAmt         Int  @default(0)
  taxExcludedAmt Int?
  keepAmount     Int  @default(0)
  oddment        Int  @default(0)

